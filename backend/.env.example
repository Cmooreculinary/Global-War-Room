# Backend environment — copy to backend/.env and fill in.

# MongoDB (required)
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=global_war_room

# LLM providers — required for deliberations, the War Room, and voice.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Stripe — required only for membership checkout / webhooks.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Public site origin used for Stripe success/cancel URLs. Required in
# production. Without it, checkout only accepts localhost (or CORS_ORIGINS
# when that list is not "*").
PUBLIC_BASE_URL=http://localhost:3000

# CORS allow-list (optional; comma-separated). Defaults to * when unset.
CORS_ORIGINS=*
