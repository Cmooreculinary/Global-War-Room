# Backend environment — copy to backend/.env and fill in.

# MongoDB (required)
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=global_war_room

# LLM providers — required for deliberations, the War Room, and voice.
# (These replaced the old EMERGENT_LLM_KEY.)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Stripe — required only for membership checkout / webhooks.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS allow-list (optional; comma-separated). Defaults to * when unset.
CORS_ORIGINS=*
