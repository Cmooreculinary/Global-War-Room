# Ollama — always use 127.0.0.1, not localhost (Node fetch can fail on IPv6).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b

# 0 = show the browser (Omarchy / desktop). 1 = headless.
HEADLESS=0

# Optional: system Chromium. Leave empty to use Playwright's browser.
# CHROMIUM_PATH=/usr/bin/chromium

# Safety
MAX_STEPS=20
STEP_TIMEOUT_MS=180000
