# Frontend environment — copy to frontend/.env and adjust.

# Base URL of the backend API.
#   - Separate dev servers: point at the backend, e.g. http://localhost:8001
#   - Single-origin build (backend serves the compiled frontend via
#     backend/serve_gwr.py): leave EMPTY so requests go to /api on the same host.
REACT_APP_BACKEND_URL=http://localhost:8001
